---
import PortfolioDetailLayout from "../../layouts/PortfolioDetailLayout.astro";
import img1 from "../../assets/website_1.png";

const projectSpecs = [
  { label: "Location", value: "My Laptop's C: Drive" },
  { label: "Dates", value: "Jan. 26 - Present" },
  { label: "Skills", value: "HTML, CSS, JavaScript, Preact, Vite, Astro"}
];
---

<PortfolioDetailLayout
  type="project"
  heroHeight="650px"
  title="My Portfolio Website"
  subtitle="Programming a personal website in the Astro Framework"
  images={[img1]}
  specs={projectSpecs}
>

    <h2>Overview</h2>
    <p>
        This website is fully designed, developed, and deployed by me! I am using the Astro framework, 
        a system designed to easily combine HTML, CSS, JavaScript, Preact, and more into a heavily optimized 
        tool. My site is deployed through GitHub Pages, and you can visit my GitHub to see my work on this 
        portfolio!
    </p>
</PortfolioDetailLayout>