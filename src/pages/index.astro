---
import BaseLayout from '../layouts/BaseLayout.astro';
import Intro from '../components/Intro.astro';
import PortfolioCard from '../components/PortfolioCard.astro';
import { Image } from 'astro:assets';
import coverPhoto from '../assets/Diagon_Headshot.jpg';
import { portfolioItems } from '../data/portfolio';

const featuredItems = portfolioItems
  .filter((item) => item.homeOrder !== undefined)
  .sort((a, b) => a.homeOrder! - b.homeOrder!);
---
<BaseLayout title="Home" mainClass="film-snap-reveal">
  <Intro />

  <section class="bio-container">
    <div class="bio-text">
      <h1 class="greeting">Hi there!</h1>

      <p class="intro-paragraph">
        My name is <strong>Ethan Gray</strong>. I'm a senior at Purdue University studying
        <strong>Multidisciplinary Engineering</strong> with a concentration in <strong>Theatre Engineering</strong>.
      </p>

      <p>
        I'm pursuing a career in technical design and engineering for the entertainment industry.
        At Purdue, I've acquired hands-on skills in rigorous design, prototyping, and fabrication which I've applied directly to the
        intersection of technology and the arts. I'm looking to utilize my love for
        storytelling, collaboration, and creativity to develop new scales of
        immersive and interactive experiences.
      </p>
    </div>

    <div class="bio-image">
      <Image
        src={coverPhoto}
        alt="Ethan Gray Headshot"
        class="headshot"
        width="400"
        height="400"
      />
    </div>
  </section>

  <section class="project-gallery">
    <h2 class="section-title">Explore My Work:</h2>
    <div class="project-grid">
      {featuredItems.map((item) => (
        <PortfolioCard {...item} />
      ))}

      <PortfolioCard
        href="/portfolio/projects/"
        title="All Projects"
        cta="View More Projects →"
      />

      <PortfolioCard
        href="/portfolio/experience/"
        title="All Experience"
        cta="View More Experience →"
      />
    </div>
  </section>
</BaseLayout>

<style>
  p { margin: 0; padding: 0; }
  p + p { margin-top: 1.5rem; }

  .bio-container {
    gap: 30px;
    align-items: center;
  }

  .greeting {
    margin: 2.5rem 0 1rem 0;
  }

  .intro-paragraph {
    font-size: 1.2rem;
    line-height: 1.6;
  }

  .headshot {
    margin-top: 3rem;
    width: 100%;
    height: auto;
  }

  .project-gallery {
    margin: 2rem 0;
  }

  @media screen and (min-width: 800px) {
    .bio-container {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
    }

    .bio-text {
      flex: 1;
    }

    .bio-image {
      flex: 0 0 300px;
    }
  }
</style>