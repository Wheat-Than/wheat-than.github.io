---
const links = [
  { label: 'Linkedin', href: 'https://www.linkedin.com/in/ethan-gray-bb024423a', external: true },
  { label: 'Github', href: 'https://www.github.com/wheat-than', external: true },
  { label: 'Resume', href: '/Ethan-Gray-Resume.pdf', external: true },
  { label: 'Contact', href: 'mailto:ethan808080@gmail.com', external: false },
];
---
<footer>
  {links.map(({ label, href, external }) => (
    <a
      href={href}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener noreferrer' : undefined}
    >
      {label}
    </a>
  ))}
</footer>

<style>
  footer {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin: 2rem 0 1rem 0;
    padding: 20px;
    flex-wrap: wrap;
  }

  a {
    padding: 0.5rem 1rem;
    color: var(--text-dark);
    border-radius: 8px;
    font-family: var(--font-mono);
    font-weight: 900;
    transition: background-color 0.3s ease, color 0.3s ease, box-shadow 0.3s ease;
  }

  a:hover,
  a:focus {
    background-color: color-mix(in srgb, var(--accent-orange), transparent 10%);
    color: #000;
    box-shadow: 0 0 30px rgba(220, 82, 9, 0.4);
  }

  :global(.dark) a {
    color: var(--text-light);
  }

  :global(.dark) a:hover,
  :global(.dark) a:focus {
    background-color: color-mix(in srgb, var(--accent-orange), transparent 30%);
    color: #fff;
    box-shadow: 0 0 30px rgba(220, 82, 9, 0.4);
  }
</style>